# Copie para .env (nunca faça commit do .env) ou configure no painel da hospedagem.

# ---------- obrigatórias em produção ----------
NODE_ENV=production
PORT=8080
# Endereço público do site, com https
BASE_URL=https://www.seudominio.com.br
# Segredo aleatório com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# 1 quando o app roda atrás de proxy/CDN (Discloud, Cloudflare, Nginx), para identificar o IP real
TRUST_PROXY=1
# Onde fica o banco SQLite (precisa ser um disco persistente)
DATABASE_FILE=./data/barbearia.db
TZ_BARBEARIA=America/Sao_Paulo

# ---------- e-mail (Resend: https://resend.com) ----------
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend, ex.: Barbearia Exemplo <agenda@seudominio.com.br>
EMAIL_FROM=

# ---------- WhatsApp Cloud API (Meta: https://developers.facebook.com/docs/whatsapp/cloud-api) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=pt_BR
# Nomes dos modelos aprovados no WhatsApp Manager (ver README)
WHATSAPP_TEMPLATE_CONFIRMACAO=
WHATSAPP_TEMPLATE_LEMBRETE=
WHATSAPP_TEMPLATE_CANCELAMENTO=
WHATSAPP_TEMPLATE_REAGENDAMENTO=
WHATSAPP_TEMPLATE_CODIGO=

# ---------- Mercado Pago (opcional: cobrança de sinal ou integral) ----------
MP_ACCESS_TOKEN=
# "Assinatura secreta" do webhook em Suas integrações > Webhooks
MP_WEBHOOK_SECRET=

# ---------- backup ----------
# 64 caracteres hex. Guarde também FORA do servidor.
BACKUP_KEY=
BACKUP_KEEP=14

# ---------- só desenvolvimento ----------
# Mostra no console (sem enviar) as mensagens que seriam enviadas
DEV_CONSOLE_NOTIFICATIONS=0
